+def cryo_specific_power(cryo_temp_k, ambient_k=300.0, frac_carnot=0.28):
+    """Wall-plug watts per watt of cooling at `cryo_temp_k`.
+
+    (T_amb - T)/T is the inverse Carnot COP; dividing by the fraction of Carnot
+    a real plant achieves gives the specific power. Returns 0.0 for a warm
+    (normal-conducting) coil, which carries no cryoplant at all.
+    """
+    if cryo_temp_k >= ambient_k:
+        return 0.0
+    return (ambient_k - cryo_temp_k) / (cryo_temp_k * frac_carnot)
+
